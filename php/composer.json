{
  "name": "cosmoner/sdk",
  "description": "Cosmoner SDK for PHP",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-mbstring": "*",
    "composer-runtime-api": "^2.0",
    "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
  },
  "autoload": {
    "psr-4": {
      "Cosmoner\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cosmoner\\Sdk\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^11.0",
    "squizlabs/php_codesniffer": "^3.10",
    "phpstan/phpstan": "^2.0"
  },
  "scripts": {
    "test": "phpunit --testdox",
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse"
  },
  "keywords": [
    "cosmoner",
    "sdk"
  ]
}
