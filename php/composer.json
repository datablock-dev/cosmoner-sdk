{
  "name": "cosmoner/sdk",
  "description": "Cosmoner SDK for PHP",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "Cosmoner\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cosmoner\\Sdk\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0 || ^11.0"
  },
  "scripts": {
    "test": "phpunit --testdox"
  },
  "keywords": [
    "cosmoner",
    "sdk"
  ]
}
